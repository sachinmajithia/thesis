# Copy this file to .env and fill in real values before running
# `docker compose up -d --build`. Never commit the real .env file.

# --- Domain (required for HTTPS) ------------------------------------------
# Point a DNS A record at this server's public/Elastic IP before starting,
# so Caddy can obtain a Let's Encrypt certificate on first request.
DOMAIN=your-domain.com

# --- Flask ------------------------------------------------------------------
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# --- Internet plagiarism search ---------------------------------------------
# Without these, /api endpoints that search the internet fall back to FAKE
# simulated results (clearly labeled 'simulated' in the response) - the app
# still runs, but internet-based plagiarism detection won't be real.
# Google Custom Search API key: https://console.cloud.google.com/apis/credentials
# Search Engine ID (create one, enable "search the entire web"):
#   https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Optional alternative/fallback to Google Custom Search
SERPAPI_KEY=

# --- Model loading ------------------------------------------------------------
# Set to 1 to skip downloading/loading the ~2.4GB NLLB-200 translation model
# (Dictionary + EBMT translation still work; NMT mode and English-gloss
# internet search won't). Useful on a smaller/cheaper instance, or to start
# the app faster while iterating.
SKIP_NMT_MODEL=0

# Leave off (0) in production - enables Werkzeug's interactive debugger,
# which allows arbitrary code execution from the browser. Irrelevant when
# running via gunicorn (the Docker setup does), only affects `python app.py`.
FLASK_DEBUG=0
